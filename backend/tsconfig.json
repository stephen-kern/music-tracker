{
    "compilerOptions": {
      "target": "ES6",
      "module": "CommonJS",
      "rootDir": "./src",  
      "outDir": "./dist",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true, 
      "baseUrl": "./src",
      "paths": {
        "@api/*": ["api/*"],
        "@controllers/*": ["controllers/*"],
        "@services/*": ["services/*"],
        "@config/*": ["config/*"],
        "@types/*": ["types/*"]
      }
    },
    "include": ["src"],  
    "exclude": ["node_modules"]
  }
  